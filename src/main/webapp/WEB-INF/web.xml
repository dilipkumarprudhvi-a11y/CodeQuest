<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="true">

    <display-name>CodeQuest</display-name>
    <description>CodeQuest - Web-Based Programming Learning Game</description>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Context Parameters (Demonstrating ServletContext) -->
    <context-param>
        <param-name>appName</param-name>
        <param-value>CodeQuest Programming Learning Game</param-value>
    </context-param>
    <context-param>
        <param-name>appVersion</param-name>
        <param-value>CodeQuest v2.4 (Enterprise Engine)</param-value>
    </context-param>
    <context-param>
        <param-name>adminContact</param-name>
        <param-value>admin@codequest.dev</param-value>
    </context-param>

    <!-- MySQL Database Connection Parameters -->
    <context-param>
        <param-name>db.url</param-name>
        <param-value>jdbc:mysql://localhost:3306/codequest_db?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC&amp;characterEncoding=UTF-8</param-value>
    </context-param>
    <context-param>
        <param-name>db.user</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>db.password</param-name>
        <param-value>@123Kumar</param-value>
    </context-param>

    <!-- ============================================== -->
    <!-- Servlet Declarations & Mappings                 -->
    <!-- ============================================== -->

    <!-- Module 2: Registration -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.codequest.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Module 3: Student Login & Logout -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.codequest.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.codequest.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Module 4: Admin Login & Logout (Demonstrating ServletConfig) -->
    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.codequest.servlet.AdminLoginServlet</servlet-class>
        <init-param>
            <param-name>adminConsoleTitle</param-name>
            <param-value>CodeQuest Administrative Command Center</param-value>
        </init-param>
        <init-param>
            <param-name>maxFailedAttempts</param-name>
            <param-value>5</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/admin-login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminLogoutServlet</servlet-name>
        <servlet-class>com.codequest.servlet.AdminLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLogoutServlet</servlet-name>
        <url-pattern>/admin-logout</url-pattern>
    </servlet-mapping>

    <!-- Module 6: Admin Question Creation -->
    <servlet>
        <servlet-name>AddQuestionServlet</servlet-name>
        <servlet-class>com.codequest.servlet.AddQuestionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddQuestionServlet</servlet-name>
        <url-pattern>/add-question</url-pattern>
    </servlet-mapping>

    <!-- Module 7: Admin Question Management -->
    <servlet>
        <servlet-name>ViewQuestionsServlet</servlet-name>
        <servlet-class>com.codequest.servlet.ViewQuestionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewQuestionsServlet</servlet-name>
        <url-pattern>/view-questions</url-pattern>
    </servlet-mapping>

    <!-- Module 8: Student Dashboard -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.codequest.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Module 9: Programming Missions Display -->
    <servlet>
        <servlet-name>MissionServlet</servlet-name>
        <servlet-class>com.codequest.servlet.MissionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MissionServlet</servlet-name>
        <url-pattern>/missions</url-pattern>
    </servlet-mapping>

    <!-- Module 10: Answer Evaluation & XP Engine (Demonstrating ServletConfig) -->
    <servlet>
        <servlet-name>SubmitAnswerServlet</servlet-name>
        <servlet-class>com.codequest.servlet.SubmitAnswerServlet</servlet-class>
        <init-param>
            <param-name>evaluationEngine</param-name>
            <param-value>CodeQuest Deterministic Engine v1.0</param-value>
        </init-param>
        <init-param>
            <param-name>level2Threshold</param-name>
            <param-value>100</param-value>
        </init-param>
        <init-param>
            <param-name>level3Threshold</param-name>
            <param-value>250</param-value>
        </init-param>
        <init-param>
            <param-name>level4Threshold</param-name>
            <param-value>450</param-value>
        </init-param>
        <init-param>
            <param-name>level5Threshold</param-name>
            <param-value>700</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>SubmitAnswerServlet</servlet-name>
        <url-pattern>/submit-answer</url-pattern>
    </servlet-mapping>

    <!-- Module 11: Global Leaderboard -->
    <servlet>
        <servlet-name>LeaderboardServlet</servlet-name>
        <servlet-class>com.codequest.servlet.LeaderboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeaderboardServlet</servlet-name>
        <url-pattern>/leaderboard</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <name>CODEQUEST_JSESSIONID</name>
        </cookie-config>
    </session-config>

</web-app>
